VITE_APP_ENV=stage
VITE_API_BASE_URL=https://api.stage.board.mathwise.ru/api
VITE_RELEASE_VERSION=stage-2026-03-31
VITE_BUILD_SOURCEMAP=1

VITE_GATEWAY_MODE=hybrid
VITE_GATEWAY_AUTH_MODE=http
VITE_GATEWAY_COURSES_MODE=http
VITE_GATEWAY_LESSONS_MODE=http
VITE_GATEWAY_ACCESS_MODE=http
VITE_GATEWAY_PROFILE_MODE=http
VITE_GATEWAY_PURCHASES_MODE=http
VITE_GATEWAY_BOOKINGS_MODE=http

VITE_RUM_ENABLED=true

