VITE_APP_ENV=stage
# Canonical stage API entrypoint (must match backend public origin model).
VITE_API_BASE_URL=https://stage.mathwise.ru/api
VITE_RELEASE_VERSION=stage-2026-03-31
VITE_BUILD_SOURCEMAP=1

VITE_GATEWAY_MODE=http
VITE_STAGE_PAYMENT_CONFIRM_ENABLED=true
VITE_LESSON_VIDEO_UPLOAD_MAX_MB=2048

VITE_RUM_ENABLED=true

# Keep disabled on shared stage unless explicitly needed for controlled demos.
VITE_ENABLE_SHOWCASE_AUTO_LOGIN=false
VITE_SHOWCASE_AUTO_LOGIN_EMAIL=
VITE_SHOWCASE_AUTO_LOGIN_PASSWORD=

# Stage consistency checklist:
# - backend API_CORS_ORIGIN should match this frontend origin
# - backend AUTH_OAUTH_REDIRECT_BASE_URL should use the same public frontend origin
# - backend YOOKASSA_RETURN_URL should return to this frontend origin (/courses)

# Rollback/degrade path examples:
# VITE_API_BASE_URL=https://stage.mathwise.ru/api
# VITE_RELEASE_VERSION=stage-rollback-<tag>
