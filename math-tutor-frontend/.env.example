VITE_APP_ENV=local
# Canonical API entrypoint for frontend HTTP transport.
VITE_API_BASE_URL=http://127.0.0.1:3001/api
VITE_RELEASE_VERSION=dev-local
VITE_BUILD_SOURCEMAP=0

VITE_GATEWAY_MODE=http
VITE_STAGE_PAYMENT_CONFIRM_ENABLED=false
VITE_LESSON_VIDEO_UPLOAD_MAX_MB=2048

VITE_RUM_ENABLED=false

# Debug-only showcase auto-login (keep disabled outside local demos).
VITE_ENABLE_SHOWCASE_AUTO_LOGIN=false
VITE_SHOWCASE_AUTO_LOGIN_EMAIL=
VITE_SHOWCASE_AUTO_LOGIN_PASSWORD=
