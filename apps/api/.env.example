APP_ENV=local
RELEASE_VERSION=dev-local
API_PORT=3001
API_HOST=0.0.0.0
API_CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/mathwise_core
REDIS_URL=redis://127.0.0.1:6379

COURSES_SEED_ON_BOOT=false
COURSES_SEED_SOURCE_FILE=../../math-tutor-frontend/mock-db.json

AUTH_SESSION_COOKIE_NAME=mt_auth_session
AUTH_SESSION_TTL_SEC=2592000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_HTTP_ONLY=true
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/
AUTH_COOKIE_MAX_AGE_SEC=2592000

AUTH_DEBUG_TOKENS=true
AUTH_PASSWORD_PEPPER=change-me-local
AUTH_RECOVERY_CODE_TTL_SEC=600
AUTH_RECOVERY_TOKEN_TTL_SEC=900
AUTH_RECOVERY_MAX_ATTEMPTS=6
AUTH_RECOVERY_RATE_LIMIT_PER_HOUR=20

EMAIL_DELIVERY_MODE=disabled
EMAIL_PROVIDER_API_KEY=

CARD_WEBHOOK_SECRET=replace-me-local-webhook-secret
CARD_WEBHOOK_MAX_SKEW_SEC=300
CARD_WEBHOOK_REPLAY_TTL_SEC=900
PAYMENT_PROVIDER_AUTO_CONFIRM_LOCAL=true

TEACHER_BOOTSTRAP_ENABLED=false
TEACHER_BOOTSTRAP_EMAIL=
TEACHER_BOOTSTRAP_PASSWORD=
TEACHER_BOOTSTRAP_FIRST_NAME=Teacher
TEACHER_BOOTSTRAP_LAST_NAME=Account

MEDIA_STORAGE_ENABLED=false
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=ru-1
S3_BUCKET=mathwise-media-local
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
MEDIA_SIGNED_URL_TTL_SEC=900
