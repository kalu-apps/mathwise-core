APP_ENV=local
RELEASE_VERSION=dev-local
# Optional fallback when RELEASE_VERSION is not set.
GIT_SHA=
API_PORT=3001
API_HOST=0.0.0.0
# Canonical public frontend origin for browser callbacks/cookies.
# Keep this origin aligned with YOOKASSA_RETURN_URL when YooKassa is enabled.
API_CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/mathwise_core
REDIS_URL=redis://127.0.0.1:6379

COURSES_SEED_ON_BOOT=false
COURSES_SEED_SOURCE_FILE=./data/seed.json
# Legacy alias (kept for compatibility). Prefer COURSES_SEED_SOURCE_FILE.
COURSES_SOURCE_FILE=

AUTH_SESSION_COOKIE_NAME=mt_auth_session
AUTH_SESSION_TTL_SEC=2592000
AUTH_SESSION_IDLE_TIMEOUT_SEC=3600
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_HTTP_ONLY=true
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/
AUTH_COOKIE_MAX_AGE_SEC=2592000

AUTH_DEBUG_TOKENS=true
AUTH_PASSWORD_PEPPER=change-me-local
AUTH_RECOVERY_CODE_TTL_SEC=600
AUTH_RECOVERY_TOKEN_TTL_SEC=900
AUTH_RECOVERY_MAX_ATTEMPTS=6
AUTH_RECOVERY_RATE_LIMIT_PER_HOUR=20
AUTH_IDENTITY_INTENTS_ENABLED=false
AUTH_IDENTITY_INTENT_TTL_SEC=900
AUTH_IDENTITY_INTENT_MAX_ATTEMPTS=6
AUTH_IDENTITY_INTENT_RATE_LIMIT_PER_HOUR=20
# Requires AUTH_IDENTITY_INTENTS_ENABLED=true
AUTH_PURCHASE_IDENTITY_INTENT_GATING_ENABLED=false

EMAIL_DELIVERY_MODE=disabled
# Used only when EMAIL_DELIVERY_MODE=provider
EMAIL_PROVIDER_API_KEY=
# Used only when EMAIL_DELIVERY_MODE=smtp
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
MAIL_FROM_NAME=Mathwise
MAIL_FROM=
MAIL_REPLY_TO=
MAIL_SUBJECT_PREFIX=
MAIL_APPEND_STAGE_FOOTER=false
MAIL_CONNECT_TIMEOUT_MS=10000
MAIL_SOCKET_TIMEOUT_MS=20000
MAIL_BCC=
MAIL_DRY_RUN=false

CARD_WEBHOOK_SECRET=replace-me-local-webhook-secret
CARD_WEBHOOK_MAX_SKEW_SEC=300
CARD_WEBHOOK_REPLAY_TTL_SEC=900
PAYMENT_PROVIDER_AUTO_CONFIRM_LOCAL=true
PAYMENT_MOCK_ENABLED=true
YOOKASSA_MODE=disabled
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_BASE=https://api.yookassa.ru/v3
# Must share origin with API_CORS_ORIGIN in non-local env.
YOOKASSA_RETURN_URL=http://localhost:5173/courses
YOOKASSA_WEBHOOK_PATH=/api/payments/providers/yookassa/webhook
YOOKASSA_CAPTURE_IMMEDIATELY=true
YOOKASSA_WEBHOOK_ENABLED=true

BOOKING_V2_ENABLED=false
# Set false only after frontend booking-v2 hold flow is fully connected.
BOOKING_V2_GUEST_COMPAT_ENABLED=true
BOOKING_SLOT_HOLD_TTL_SEC=900

TEACHER_INVITES_ENABLED=false
TEACHER_INVITE_TTL_SEC=604800
# Stage-gated runtime controls (effective only when APP_ENV=stage).
STAGE_SITE_GATE_ENABLED=false
STAGE_SITE_GATE_SECRET=
STAGE_SITE_GATE_COOKIE_NAME=mt_stage_access
STAGE_SITE_GATE_TTL_SEC=43200
STAGE_PAYMENT_CONFIRM_ENABLED=false

TEACHER_BOOTSTRAP_ENABLED=false
TEACHER_BOOTSTRAP_EMAIL=
TEACHER_BOOTSTRAP_PASSWORD=
TEACHER_BOOTSTRAP_FIRST_NAME=Teacher
TEACHER_BOOTSTRAP_LAST_NAME=Account

MEDIA_STORAGE_ENABLED=false
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=ru-1
S3_BUCKET=mathwise-media-local
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
MEDIA_SIGNED_URL_TTL_SEC=900
MEDIA_LESSON_VIDEO_MAX_UPLOAD_MB=2048
MEDIA_GC_INTERVAL_SEC=300
MEDIA_GC_BATCH_LIMIT=200

WORKBOOK_LAUNCH_ENABLED=true
WORKBOOK_BOARD_BASE_URL=http://127.0.0.1:4173
WORKBOOK_LAUNCH_SECRET=replace-me-local-workbook-launch-secret
WORKBOOK_LAUNCH_TTL_SEC=120
